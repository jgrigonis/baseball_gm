# Copy to .env and fill in. .env holds secrets: it's in .gitignore, and
# .dockerignore keeps it out of the image. docker-compose.yml reads it.

# The site's address. Caddy gets an HTTPS certificate for this host, and
# links in emails point here. Its DNS A record must point at this server.
PUBLIC_BASE_URL=https://baseball.gbros.us

# The database password. Make it long and random, e.g. `openssl rand -hex 32`.
# Postgres keeps the one it was first started with: changing it here later
# also needs ALTER USER gm PASSWORD '...' in the database.
POSTGRES_PASSWORD=

# The "admin" login's password until it is changed at first sign-in. Used
# once, when the database is created; required (not "changeme") over HTTPS.
ADMIN_INITIAL_PASSWORD=

# Outgoing email, for password reset links. See DEPLOY.md for the DNS
# records (SPF, DKIM) your provider asks for. Without SMTP_HOST, emails are
# only written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=GM Sim <noreply@gm.example.com>

# Web server processes. About one per CPU core is plenty; sims run in the
# worker, not here.
WEB_CONCURRENCY=2

# Nightly database backups: the hour (UTC) and how many days to keep.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# The browser pages are served by the app itself, so no other site needs to
# call it.
CORS_ORIGINS=[]
